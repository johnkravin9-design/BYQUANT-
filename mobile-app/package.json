{
  "name": "byquant-mobile-app",
  "version": "0.1.0",
  "private": true,
  "main": "src/App.tsx",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "jest --runInBand"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-native": "0.79.7"
  },
  "devDependencies": {
    "@types/jest": "30.0.0",
    "@types/react": "19.0.0",
    "@types/react-test-renderer": "19.0.0",
    "jest": "30.4.2",
    "react-test-renderer": "19.2.8",
    "ts-jest": "29.4.12",
    "typescript": "5.8.0"
  },
  "jest": {
    "transform": {
      "^.+\\.tsx?$": [
        "ts-jest",
        {
          "tsconfig": "tsconfig.json"
        }
      ]
    },
    "testMatch": [
      "**/src/**/*.test.ts",
      "**/src/**/*.test.tsx"
    ],
    "setupFiles": [
      "<rootDir>/src/__tests__/jest.setup.ts"
    ],
    "testEnvironment": "node",
    "moduleNameMapper": {
      "^react-native$": "<rootDir>/src/__tests__/react-native.mock.ts"
    }
  }
}
