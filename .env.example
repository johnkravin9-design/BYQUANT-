# Shared
NODE_ENV=development
LOG_LEVEL=info

# PostgreSQL / Docker Compose
POSTGRES_DB=byquant
POSTGRES_USER=byquant
POSTGRES_PASSWORD=change_me_local_only
DATABASE_URL=postgresql://user:password@localhost:5432/byquant_local

# API Gateway
PORT=3000
TELEGRAM_BOT_TOKEN=replace_with_telegram_bot_token_optional_until_enabled
TELEGRAM_CHANNEL_ID=replace_with_telegram_channel_id_optional_until_enabled
FIREBASE_CREDENTIALS_PATH=./firebase-service-account.local.json
CORS_ORIGIN=http://localhost:8081

# Backend Engine
BYBIT_API_KEY=replace_with_bybit_api_key_optional_for_public_market_data
BYBIT_API_SECRET=replace_with_bybit_api_secret_optional_for_public_market_data
BYBIT_ENV=testnet
MIDDLEWARE_WEBHOOK_URL=http://localhost:3000/api/signals/webhook
MIDDLEWARE_AUTH_TOKEN=replace_with_same_strong_random_secret
BYQUANT_SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT,LINKUSDT,AVAXUSDT,NEARUSDT,DOTUSDT,ADAUSDT,XRPUSDT,LTCUSDT,UNIUSDT,ATOMUSDT,ICPUSDT,FILUSDT,APTUSDT,SUIUSDT,OPUSDT,ARBUSDT,TIAUSDT,INJUSDT,LDOUSDT,STXUSDT,GRTUSDT,IMXUSDT,RENDERUSDT,FETUSDT
CANDLE_INTERVAL=60
MARKET_WINDOW_SIZE=250
BACKFILL_LIMIT=250
SIGNAL_DEDUPE_MAX_SIZE=1000

# Mobile application API base URL for React Native development.
BYQUANT_API_URL=http://localhost:3000
